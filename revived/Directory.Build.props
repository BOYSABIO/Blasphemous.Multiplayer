<Project>
  <PropertyGroup>
    <Version>2.9.0</Version>
    <InformationalVersion>2.9.0-dev</InformationalVersion>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Authors>Damocles</Authors>
    <Company>Damocles</Company>
    <RepositoryUrl>https://github.com/BOYSABIO/Blasphemous.Multiplayer</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
