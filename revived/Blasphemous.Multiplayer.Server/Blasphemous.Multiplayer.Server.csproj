<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>blas1mpserver</AssemblyName>
    <RootNamespace>Blasphemous.Multiplayer.Server</RootNamespace>
    <Description>Recovered protocol-16 Blasphemous multiplayer server.</Description>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Basalt.CommandParser" Version="[2.0.0]" />
    <ProjectReference Include="..\Blasphemous.Multiplayer.Common\Blasphemous.Multiplayer.Common.csproj" />
    <Reference Include="SimpleTCP">
      <HintPath>..\..\resources\data\SimpleTCP.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
